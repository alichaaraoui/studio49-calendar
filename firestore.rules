rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function text(v, max) { return v is string && v.size() > 0 && v.size() <= max; }

    // One document per teammate: their name and weekly free slots ("day-slot" keys).
    match /people/{id} {
      allow read, delete: if true;
      allow create, update: if text(request.resource.data.name, 60)
        && request.resource.data.slots is list
        && request.resource.data.slots.size() <= 196
        && request.resource.data.keys().hasOnly(['name', 'slots', 'updatedAt']);
    }

    // Teams (Design, Engineering, ...) and who is in them.
    match /groups/{id} {
      allow read, delete: if true;
      allow create, update: if text(request.resource.data.name, 60)
        && request.resource.data.members is list
        && request.resource.data.members.size() <= 100
        && request.resource.data.keys().hasOnly(['name', 'members']);
    }

    // Booked meetings.
    match /meetings/{id} {
      allow read, delete: if true;
      allow create, update: if text(request.resource.data.title, 80)
        && request.resource.data.date is string
        && request.resource.data.start is int && request.resource.data.start >= 0 && request.resource.data.start < 28
        && request.resource.data.len is int && request.resource.data.len >= 1 && request.resource.data.len <= 4
        && request.resource.data.keys().hasOnly(['title', 'group', 'date', 'start', 'len', 'location', 'createdBy', 'createdAt']);
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
